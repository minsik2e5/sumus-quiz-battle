{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "app/page.tsx",
    "app/main.tsx",
    "app/env.d.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "vite.config.ts",
    "worker/**/*.ts",
    "db/**/*.ts",
    "drizzle.config.ts",
    "vite.worker.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
