{
  // SUMUS 수업관리 플래너 (separate Worker from VOCA; deployed by .github/workflows/deploy-planner.yml)
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sumus-planner",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [{ "name": "PLANNER_STATE", "class_name": "PlannerState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlannerState"] }],
  "observability": { "enabled": true }
}
