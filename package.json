{
  "name": "sumus-voca",
  "version": "13.126.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node server/boot.mjs",
    "setup": "node server/setup.mjs",
    "build:assets": "node server/build-assets.mjs",
    "check": "node -e \"import('./server/release-check.mjs').then(m => m.runReleaseCheck())\"",
    "check:cloudflare": "node server/cloudflare-check.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build:assets && npm run check && wrangler deploy",
    "cf:types": "wrangler types",
    "check:load": "node server/stress-check.mjs",
    "check:sql": "node server/sql-check.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "wrangler": "4.135.0"
  }
}
