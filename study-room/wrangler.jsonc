{
  // SUMUS 공부방 - Cloudflare Workers 배포 설정
  "name": "sumus-study-room",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node cloudflare/build.js" },
  "assets": { "directory": "./cloudflare/dist", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ACADEMY", "class_name": "AcademyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AcademyRoom"] }],
  "observability": { "enabled": true }
  // 선생님 키는 비밀 값으로: npx wrangler secret put STUDY_TEACHER_KEY
}
