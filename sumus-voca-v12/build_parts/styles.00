@charset "UTF-8";:root{--bg:#f7f8fa;--paper:#fff;--ink:#242a38;--sub:#717989;--muted:#969eaa;--line:#e9ecf1;--blue:#3765e9;--blue-soft:#edf2ff;--green:#22866c;--red:#c75952;--radius:22px;--ease:cubic-bezier(.2,.8,.2,1)}*{box-sizing:border-box}html{font-family:Pretendard,"Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#eef0f4;-webkit-font-smoothing:antialiased}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;background:none;color:inherit;-webkit-tap-highlight-color:transparent}button:disabled{cursor:default;opacity:.45}button,input,select,textarea,a{touch-action:manipulation}button:focus-visible,a:focus-visible{outline:3px solid #87a7ff;outline-offset:3px}input,select,textarea{min-width:0;width:100%;border:1px solid #dfe4ec;background:#fff;border-radius:12px;padding:14px;color:var(--ink);font-size:16px;outline:none;transition:.2s}input:focus,select:focus,textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px #3765e912}input[type=checkbox],input[type=radio]{width:20px;height:20px;accent-color:var(--blue);box-shadow:none}h1,h2,h3,p{margin:0}h1,h2,h3{letter-spacing:-.05em}h1{font-size:28px;line-height:1.35}h2{font-size:22px;line-height:1.45}h3{font-size:17px}p{line-height:1.65}a{color:var(--blue)}.icon{width:22px;height:22px;flex-shrink:0}.hidden{display:none!important}.muted{color:var(--sub)}.tiny{font-size:12px}.eyebrow{font-size:11px;letter-spacing:.13em;font-weight:700;color:var(--sub)}.row{display:flex;align-items:center;gap:12px;min-width:0}.between{justify-content:space-between}.stack{display:grid;gap:12px}.grow{flex:1;min-width:0}.right{text-align:right}.num{font-variant-numeric:tabular-nums}.btn{min-height:50px;display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:14px;padding:13px 18px;font-weight:650;font-size:15px;background:#edf0f5;transition:background .16s,transform .16s;color:#465063}.btn:active:not(:disabled){transform:scale(.98)}.btn.primary{background:var(--blue);color:#fff}.btn.ink{background:#283044;color:#fff}.btn.secondary{background:var(--blue-soft);color:var(--blue)}.btn.danger{background:#fff0ed;color:var(--red)}.btn.small{min-height:40px;font-size:13px;padding:10px 14px;border-radius:11px}.btn.full{width:100%}.text-button{color:var(--blue);font-size:13px;font-weight:600;min-height:44px;padding:8px 4px;display:inline-flex;align-items:center;justify-content:center;gap:5px}.text-button .icon{width:16px}.icon-button{width:44px;height:44px;display:inline-grid;place-items:center;flex-shrink:0;border-radius:14px;background:#fff;border:1px solid var(--line)}.busy{pointer-events:none;opacity:.65}.pill{display:inline-flex;gap:4px;align-items:center;padding:5px 9px;border-radius:7px;background:#f0f2f6;font-size:11px;font-weight:650;color:var(--sub);white-space:nowrap}.pill.blue{background:var(--blue-soft);color:var(--blue)}.pill.green{background:#eaf6f0;color:var(--green)}.pill.red{background:#fbefed;color:var(--red)}.pill .icon{width:13px;height:13px}.progress{height:5px;border-radius:20px;background:#e8ebf1;overflow:hidden}.progress>i{display:block;height:100%;border-radius:20px;background:var(--blue);transition:width .5s var(--ease)}.boot{height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;letter-spacing:.12em;font-size:27px;gap:16px}.boot span{font-size:14px;font-weight:400;letter-spacing:0;color:var(--sub)}.student-app{max-width:480px;margin:auto;background:var(--bg);min-height:100svh;box-shadow:0 0 0 1px #e6e9ef}.student-main{padding:22px 24px calc(102px + env(safe-area-inset-bottom));min-height:100svh}.brand{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:800;letter-spacing:.045em}.brand img{width:28px;height:28px}.brand span{font-weight:450;color:var(--sub);letter-spacing:.05em}.app-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:29px;height:34px}.app-header .profile-dot{width:34px;height:34px;border-radius:50%;background:#e9edf7;display:grid;place-items:center;font-size:12px;color:#55607a}.bottom-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(480px,100%);z-index:30;display:grid;grid-template-columns:repeat(5,1fr);padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);border-top:1px solid var(--line);backdrop-filter:blur(14px)}.bottom-nav button{display:flex;align-items:center;flex-direction:column;gap:5px;min-height:49px;justify-content:center;font-size:10px;font-weight:550;color:#9097a5;border-radius:12px}.bottom-nav button.active{color:var(--blue)}.bottom-nav .icon{width:22px;height:22px}.bottom-nav button.active .icon{fill:#3765e911;stroke-width:2}.page-heading{margin-bottom:24px}.page-heading>p{color:var(--sub);font-size:13px;margin-top:7px}.hello{font-size:13px;color:var(--sub);margin-bottom:5px}.home-title{font-size:27px;letter-spacing:-.055em}.streak-badge{font-size:12px;display:flex;gap:5px;align-items:center;color:#aa7746;background:#f5eee4;padding:7px 10px;border-radius:10px;white-space:nowrap}.streak-badge .icon{width:15px;height:15px}.character-hero{margin:22px 0 24px;border:1px solid #e9e7ee;border-radius:25px;overflow:hidden;background:linear-gradient(145deg,#f2f0f6,#f5f3f7 45%,#f9f6f0);position:relative}.hero-top{display:flex;justify-content:space-between;padding:20px 20px 0;align-items:flex-start}.hero-top small{display:block;margin-top:3px;color:#848197;font-size:11px}.hero-top .pill{background:#ffffff8c;color:#786e88}.character-stage{height:160px;position:relative;display:flex;justify-content:center;align-items:center}.character-stage:before{content:"";position:absolute;width:228px;height:82px;border:1px solid #dcd8e699;transform:rotate(-12deg);border-radius:50%;bottom:23px}.character-stage:after{content:"";width:6px;height:6px;border-radius:50%;background:#baafce;position:absolute;left:20%;top:48px;box-shadow:209px 35px