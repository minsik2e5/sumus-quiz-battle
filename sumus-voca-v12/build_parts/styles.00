 1fr;gap:9px}.mode-option{display:flex;align-items:center;text-align:left;gap:8px;font-size:12px;font-weight:550;border:1px solid var(--line);padding:13px 10px;min-height:50px;border-radius:12px;background:#fff;min-width:0}.mode-option .icon{width:17px;color:#8a96ad}.mode-option.selected{border-color:#829ee9;background:var(--blue-soft);color:var(--blue)}.mode-option:first-child{grid-column:1/-1}.practice-launch{margin-top:23px}.practice-launch p{text-align:center;font-size:11px;color:var(--muted);margin-top:9px}.exam-info{padding:18px;border-radius:16px;background:#eef1f6;margin:18px 0;font-size:12px;color:var(--sub);display:flex;gap:10px}.exam-info .icon{width:19px}.exam-list .exam-card{background:#fff;border:1px solid var(--line);border-radius:19px;padding:18px;margin-top:12px}.exam-card h3{font-size:17px;margin:12px 0 5px;line-height:1.5;overflow-wrap:anywhere}.exam-card p{font-size:12px;color:var(--sub)}.exam-card .exam-meta{display:flex;gap:13px;margin:14px 0;font-size:11px;color:var(--sub);flex-wrap:wrap}.exam-card .btn{min-height:43px;font-size:13px}.empty-state{padding:36px 18px;text-align:center;color:#919baa}.empty-state>.icon{width:34px;height:34px;stroke-width:1.2;color:#a5afbf;margin-bottom:12px}.empty-state h3{font-size:15px;color:#777f8e;letter-spacing:-.025em;font-weight:550}.empty-state p{font-size:12px;margin-top:8px}.record-row{border-bottom:1px solid var(--line);padding:17px 0;display:flex;gap:12px;align-items:center}.record-row strong{font-size:14px}.record-row p{font-size:11px;color:var(--sub);margin-top:5px}.record-row .result{font-size:17px;white-space:nowrap;color:var(--blue);font-weight:700}.record-row .result small{display:block;text-align:right;font-size:10px;color:var(--sub);font-weight:400;margin-top:5px}.record-stats{display:grid;grid-template-columns:repeat(3,1fr);padding:24px 0;border-bottom:1px solid var(--line);margin-bottom:12px}.record-stats div{text-align:center;border-right:1px solid var(--line)}.record-stats div:last-child{bor